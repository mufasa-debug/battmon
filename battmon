clear_main_menu_screen() {
    # Use the terminal's terminfo-aware clear sequence first.
    if command -v clear >/dev/null 2>&1; then
        clear 2>/dev/null || true
    fi
    # iTerm2 documents this OSC sequence specifically for clearing scrollback.
    # Run it after `clear` so lines removed from the display are erased too.
    if [ "${TERM_PROGRAM:-}" = "iTerm.app" ] || [ -n "${ITERM_SESSION_ID:-}" ]; then
        printf '\033]1337;ClearScrollback\a'
    fi
    # CSI 3 J clears conventional scrollback; CSI 2 J clears the display;
    # CSI H places the dashboard at the top-left corner.
    printf '\033[H\033[2J\033[3J\033[H'
}

main_menu() {
    while true; do
        load_config || {
            echo "Configuration is invalid. Run 'battmon doctor' for details."
            return 1
        }
        local pct="N/A" pwr="Power unavailable" audio_info="" cur_v="N/A" cur_muted=""
        local monitor_line=" Monitor: OFF - ALERTS DISABLED"
        if get_battery_state; then
            pct="$BATTERY_PERCENT"
            pwr=$(battery_status_label)
        fi
        if audio_info=$(get_audio_settings); then
            read -r cur_v cur_muted <<< "$audio_info"
            [ "$cur_muted" = "true" ] && cur_v="${cur_v}M"
        fi
        is_service_running && monitor_line=" Monitor: ON - automatic alerts active"

        clear_main_menu_screen
        echo "─── BATTMON 🦇 Battery Voice Monitor ─────────────────────────────────────"
        local bat_str=" Battery: ${pct}% (${pwr})"
        [ "$pct" = "N/A" ] && bat_str=" Battery: Not detected"
        printf "%-36s | Volume: %s (target %s%%)\n" "$bat_str" "${cur_v}" "$ALERT_VOLUME"
        printf "%-36s | Stop: charger or MUTE/DOWN\n" "$monitor_line"
        echo "──────────────────────────────────────────────────────────────────────────"
        echo " Configured Alerts:"
        local idx=0
        local max_preview=6
        for alert in "${ALERTS[@]}"; do
            ((idx++))
            if [ $idx -gt $max_preview ] && [ "${#ALERTS[@]}" -gt $max_preview ]; then
                local remain=$((${#ALERTS[@]} - max_preview))
                printf "    (... and %d more alerts - view all via option 4)\n" "$remain"
                break
            fi
            parse_alert_entry "$alert"
            local ui_type
            ui_type=$(alert_type_short_name "$PARSED_TYP")
            local trunc_msg="$PARSED_MSG"
            if [ "${#trunc_msg}" -gt 33 ]; then trunc_msg="${trunc_msg:0:30}..."; fi
            printf "  • %3d%% [%-8s] %-3s %4sms \"%s\"\n" "$PARSED_LVL" "$ui_type" "$(repeat_compact_display "$PARSED_REP")" "$PARSED_DEL" "$trunc_msg"
        done
        echo "──────────────────────────────────────────────────────────────────────────"
        printf "  1) Edit an alert rule            7) Audio & media settings\n"
        printf "  2) Add new battery alert         8) Test voice & silencing keys\n"
        printf "  3) Delete an alert rule          9) Background service controls\n"
        printf "  4) View all alerts & status     10) Reset everything to default\n"
        printf "  5) Change repeat & pause delay  11) Exit Battmon\n"
        printf "  6) Apply to existing rules\n"
        echo "──────────────────────────────────────────────────────────────────────────"
        if ! read -r -p " Enter choice [1-11] (or 'c' to exit): " choice; then
            echo ""
            echo "Input closed. Goodbye!"
            return 0
        fi

        if [ "$choice" = "c" ] || [ "$choice" = "C" ]; then
            echo "Goodbye!"
            exit 0
        fi

        case "$choice" in
            1) edit_alert ;;
            2) add_alert ;;
            3) delete_alert ;;
            4)
                show_status
                read -r -p "Press [Enter] to return (or 'c')..."
                ;;
            5) edit_timing ;;
            6) apply_timing_to_existing_rules ;;
            7) audio_media_menu ;;
            8) test_voice_interruption ;;
            9) service_menu ;;
            10) reset_defaults ;;
            11)
                echo "Goodbye!"
                exit 0
                ;;
            *)
                echo "Please enter a number between 1 and 11 (or 'c' to exit)."
                sleep 0.8
                ;;
        esac
    done
}

doctor() {
    local failures=0 command_name settings
    echo "─── BATTMON DOCTOR ───────────────────────────────────────────────────────"
    if [ "$(uname -s)" = "Darwin" ]; then
        echo " [OK] macOS detected"
    else
        echo " [FAIL] Battmon requires macOS"
        failures=$((failures + 1))
    fi
    for command_name in pmset say launchctl osascript pgrep ps ioreg sysctl awk sed sort mktemp cmp plutil; do
        if command -v "$command_name" >/dev/null 2>&1; then
            printf ' [OK] %s\n' "$command_name"
        else
            printf ' [FAIL] Missing built-in command: %s\n' "$command_name"
            failures=$((failures + 1))
        fi
    done
    if load_config; then
        printf ' [OK] Config valid (%d normalized rules)\n' "${#ALERTS[@]}"
        [ -n "$CONFIG_WARNING" ] && printf ' [WARN] %s\n' "$CONFIG_WARNING"
    else
        echo " [FAIL] Configuration could not be loaded"
        failures=$((failures + 1))
    fi
    if get_battery_state; then
        printf ' [OK] Battery %s%% — %s\n' "$BATTERY_PERCENT" "$(battery_status_label)"
    else
        echo " [FAIL] No supported internal battery detected"
        failures=$((failures + 1))
    fi
    if settings=$(get_audio_settings); then
        printf ' [OK] Audio settings readable (%s)\n' "$settings"
    else
        echo " [FAIL] Audio settings unavailable in this session"
        failures=$((failures + 1))
    fi
    if [ -f "$PLIST_DST" ] && plutil -lint "$PLIST_DST" >/dev/null 2>&1; then
        echo " [OK] LaunchAgent plist valid"
    else
        echo " [INFO] LaunchAgent is not installed"
    fi
    if command -v battmon >/dev/null 2>&1; then
        printf ' [OK] Command in PATH (%s)\n' "$(command -v battmon)"
    else
        echo " [INFO] 'battmon' is not in current PATH. To fix: export PATH=\"\$HOME/.local/bin:\$PATH\""
    fi
    if is_service_running; then
        echo " [OK] Background service loaded"
    else
        echo " [FAIL] Background service stopped — automatic alerts cannot run"
        failures=$((failures + 1))
    fi
    echo "──────────────────────────────────────────────────────────────────────────"
    if [ "$failures" -eq 0 ]; then
        echo "Battmon doctor found no blocking errors."
    else
        echo "Battmon doctor found $failures blocking error(s)."
        return 1
    fi
}

case "$1" in
    -h|--help|help)
        show_help
        ;;
    status)
        show_status
        ;;
    install|start)
        service_install
        ;;
    stop)
        service_stop
        ;;
    restart)
        service_restart
        ;;
    run)
        /bin/bash "$SCRIPT_DIR/battery_monitor.sh"
        ;;
    test)
        test_voice_interruption
        ;;
    reset)
        reset_defaults
        ;;
    symlinks)
        install_symlinks
        ;;
    edit)
        ensure_active_config || exit 1
        "${EDITOR:-nano}" "$CONFIG_FILE"
        load_config || exit 1
        save_config
        ;;
    doctor)
        doctor
        ;;
    migrate|migrate-config)
        ensure_active_config || exit 1
        load_config || exit 1
        save_config
        ;;
    "")
        main_menu
        ;;
    *)
        printf 'Battmon: unknown command: %s\n\n' "$1" >&2
        show_help >&2
        exit 2
        ;;
esac
