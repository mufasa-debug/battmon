        echo "─── Background Service Controls ──────────────────────────────────────────"
        echo "  1) Start background service (auto-starts on boot)"
        echo "  2) Stop background service"
        echo "  3) Restart service"
        echo "  4) Trigger one immediate battery check now"
        echo "  5) Return to Main Menu"
        echo "──────────────────────────────────────────────────────────────────────────"
        local schoice
        if ! prompt_number "Enter choice [1-5] (or 'c' to cancel): " 1 5 "5" schoice; then
