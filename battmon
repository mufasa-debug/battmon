#!/bin/bash
# ==============================================================================
# BATTMON: macOS Battery Voice Monitor & Interactive Manager
# Universal for any macOS machine. Standard 80x24 terminal friendly.
# ==============================================================================

# Resolve symlink to locate the real directory containing battmon
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

COMMON_FILE="$SCRIPT_DIR/battmon_common.sh"
if [ ! -f "$COMMON_FILE" ]; then
    printf 'Battmon: missing %s\n' "$COMMON_FILE" >&2
    exit 2
fi
source "$COMMON_FILE" || exit 2

RUNTIME_DIR="$BATTMON_RUNTIME_DIR"
RUNTIME_CONFIG="$BATTMON_CONFIG_FILE"
PACKAGE_CONFIG="$BATTMON_TEMPLATE_CONFIG"
CONFIG_FILE="$BATTMON_CONFIG_FILE"
PLIST_DST="$BATTMON_PLIST"
LOG_FILE="$BATTMON_LOG_FILE"
STATE_FILE="$BATTMON_STATE_FILE"

show_help() {
    cat << EOF
─── BATTMON 🦇 macOS Battery Voice Monitor ───────────────────────────────
Usage: battmon [command|option]

Commands:
  battmon              Open interactive number-based terminal GUI
  battmon -h, --help   Show this help manual and exit
  battmon status       Show battery level, volume target & alert rules
  battmon test         Test voice alerts, charger cutoff & keyboard keys
  battmon run          Trigger an immediate battery evaluation cycle
  battmon start/stop   Start or stop background monitor
  battmon restart      Restart background service and refresh config
  battmon edit         Open battery_config.sh in text editor
  battmon doctor       Run read-only installation and runtime checks
  battmon migrate      Validate and safely rewrite the active config

Silencing Shortcuts:
  • Charging alert: unplug the charger to stop the voice.
  • Low-battery alert: start charging to stop the voice.
  • Any alert: press MUTE (F10) or VOLUME DOWN (F11).
  • Alerts stay silent while macOS is locked and just after a cold boot.

Files:
  Config : ~/.battmon/battery_config.sh
  Logs   : ~/Library/Logs/Battmon/battmon.log
──────────────────────────────────────────────────────────────────────────
EOF
}

if ! load_config; then
    printf 'Battmon: using safe built-in defaults because configuration loading failed.\n' >&2
    set_builtin_defaults
fi

sync_runtime_files() {
    ensure_runtime_dirs || return 1
    [ "$SCRIPT_DIR" = "$RUNTIME_DIR" ] && return 0

    local file source_path temp_path mode
    for file in battmon battery_monitor.sh battmon_common.sh; do
        source_path="$SCRIPT_DIR/$file"
        [ -f "$source_path" ] || {
            printf 'Battmon: missing installation file %s\n' "$source_path" >&2
            return 1
        }
        temp_path=$(mktemp "$RUNTIME_DIR/.${file}.XXXXXX") || return 1
        if ! cp "$source_path" "$temp_path"; then
            rm -f "$temp_path"
            return 1
        fi
        mode=755
        [ "$file" = "battmon_common.sh" ] && mode=644
        chmod "$mode" "$temp_path" || {
            rm -f "$temp_path"
            return 1
        }
        mv -f "$temp_path" "$RUNTIME_DIR/$file" || return 1
    done
}

is_service_running() {
    local uid_value
    uid_value=$(id -u)
    launchctl print "gui/${uid_value}/${BATTMON_LABEL}" >/dev/null 2>&1
}

write_launch_agent() {
    local plist_dir temp_plist
    plist_dir=$(dirname "$PLIST_DST")
    mkdir -p "$plist_dir" "$BATTMON_LOG_DIR" || return 1
    temp_plist=$(mktemp "$plist_dir/.com.battery.batmon.XXXXXX") || return 1
    cat << EOF > "$temp_plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.battery.batmon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>$HOME/.battmon/battery_monitor.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>$BATTMON_LOG_FILE</string>
    <key>StandardErrorPath</key>
    <string>$BATTMON_LOG_FILE</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
EOF
    if ! plutil -lint "$temp_plist" >/dev/null; then
        rm -f "$temp_plist"
        printf 'Battmon: generated LaunchAgent is invalid.\n' >&2
        return 1
    fi
    chmod 600 "$temp_plist" || {
        rm -f "$temp_plist"
        return 1
    }
    mv -f "$temp_plist" "$PLIST_DST"
}

service_install() {
    local uid_value
    uid_value=$(id -u)
    ensure_active_config || return 1
    load_config || return 1
    save_config >/dev/null || return 1
    sync_runtime_files || return 1
    install_symlinks || return 1
    write_launch_agent || return 1

    launchctl bootout "gui/${uid_value}/${BATTMON_LABEL}" >/dev/null 2>&1 || true
    if ! launchctl bootstrap "gui/${uid_value}" "$PLIST_DST"; then
        printf 'Battmon: LaunchAgent failed to load.\n' >&2
        return 1
    fi
    if ! is_service_running; then
        printf 'Battmon: LaunchAgent loaded but could not be verified.\n' >&2
        return 1
    fi
    echo "Background monitor is active and will run after login."
}

service_stop() {
    local uid_value service_was_running=0 monitor_stopped=0 forced_stop=0
    local monitor_pid existing_pid attempts=0 remaining=0 lock_pid="" lock_listed=0
    local monitor_pids=()
    uid_value=$(id -u)
    if is_service_running; then
        service_was_running=1
        if ! launchctl bootout "gui/${uid_value}/${BATTMON_LABEL}"; then
            printf 'Battmon: background monitor could not be stopped.\n' >&2
            return 1
        fi
    fi

    while IFS= read -r monitor_pid; do
        [ -n "$monitor_pid" ] && monitor_pids+=("$monitor_pid")
    done < <(list_managed_monitor_pids)

    if [ -f "$BATTMON_MONITOR_LOCK/pid" ]; then
        lock_pid=$(sed -n '1p' "$BATTMON_MONITOR_LOCK/pid" 2>/dev/null || true)
        if is_managed_monitor_pid "$lock_pid"; then
            for existing_pid in "${monitor_pids[@]}"; do
                [ "$existing_pid" = "$lock_pid" ] && lock_listed=1
            done
            [ "$lock_listed" -eq 0 ] && monitor_pids+=("$lock_pid")
        fi
    fi

    if [ "${#monitor_pids[@]}" -gt 0 ]; then
        monitor_stopped=1
        for monitor_pid in "${monitor_pids[@]}"; do
            is_managed_monitor_pid "$monitor_pid" && kill -TERM "$monitor_pid" 2>/dev/null || true
        done
        while [ "$attempts" -lt 100 ]; do
            remaining=0
            for monitor_pid in "${monitor_pids[@]}"; do
                if is_managed_monitor_pid "$monitor_pid"; then
                    remaining=1
                    break
                fi
            done
            [ "$remaining" -eq 0 ] && break
            sleep 0.1
            attempts=$((attempts + 1))
        done
        for monitor_pid in "${monitor_pids[@]}"; do
            if is_managed_monitor_pid "$monitor_pid"; then
                kill -KILL "$monitor_pid" 2>/dev/null || true
                forced_stop=1
            fi
        done
    fi

    if [ -f "$BATTMON_MONITOR_LOCK/pid" ]; then
        lock_pid=$(sed -n '1p' "$BATTMON_MONITOR_LOCK/pid" 2>/dev/null || true)
        if ! is_managed_monitor_pid "$lock_pid"; then
            rm -f "$BATTMON_MONITOR_LOCK/pid" 2>/dev/null || true
            rmdir "$BATTMON_MONITOR_LOCK" 2>/dev/null || true
        fi
    fi

    [ "$forced_stop" -eq 1 ] && echo "Battmon: an unresponsive orphan monitor required a forced stop." >&2
    if [ "$service_was_running" -eq 1 ] || [ "$monitor_stopped" -eq 1 ]; then
        echo "Background monitor and active alert stopped."
    else
        echo "Background monitor is already stopped."
    fi
}

service_start() {
    service_install
}

service_restart() {
    service_stop || return 1
    service_start
}

install_symlinks() {
    local bindir="$HOME/.local/bin" link_path="$HOME/.local/bin/battmon" target=""
    mkdir -p "$bindir" || return 1
    if [ -e "$link_path" ] || [ -L "$link_path" ]; then
        if [ -L "$link_path" ]; then
            target=$(readlink "$link_path")
            case "$target" in
                "$RUNTIME_DIR/battmon"|"$SCRIPT_DIR/battmon") ;;
                *)
                    printf 'Battmon: refusing to replace existing command %s -> %s\n' "$link_path" "$target" >&2
                    return 1
                    ;;
            esac
        else
            printf 'Battmon: refusing to replace existing file %s\n' "$link_path" >&2
            return 1
        fi
    fi
    ln -sfn "$RUNTIME_DIR/battmon" "$link_path"
}

prompt_number() {
    local prompt_msg="$1"
    local min_val="$2"
    local max_val="$3"
    local default_val="$4"
    local result_var="$5"

    while true; do
        if ! read -r -p "$prompt_msg" input_val; then
            echo ""
            echo "Input closed; returning."
            return 1
        fi
        input_val=$(echo "$input_val" | tr -d '[:space:]')

        if [ "$input_val" = "c" ] || [ "$input_val" = "C" ]; then
            echo "Cancelled."
            return 1
        fi

        if [ -z "$input_val" ] && [ -n "$default_val" ]; then
            eval "$result_var=\"$default_val\""
            return 0
        fi

        if [[ "$input_val" =~ ^[0-9]+$ ]]; then
            if [ -n "$min_val" ] && [ "$input_val" -lt "$min_val" ]; then
                echo "Please enter a number that is at least $min_val (or 'c' to cancel)."
                continue
            fi
            if [ -n "$max_val" ] && [ "$input_val" -gt "$max_val" ]; then
                echo "Please enter a number that is at most $max_val (or 'c' to cancel)."
                continue
            fi
            eval "$result_var=\"$input_val\""
            return 0
        else
            echo "Please enter numbers only (e.g. 10), or 'c' to cancel."
        fi
    done
}

alert_type_short_name() {
    case "$1" in
        HIGH) printf 'CHARGING' ;;
        LOW) printf 'LOW-BATT' ;;
        *) printf '%s' "$1" ;;
    esac
}

alert_type_plain_name() {
    case "$1" in
        HIGH) printf 'Charging alert (battery going up)' ;;
        LOW) printf 'Low-battery alert (battery going down)' ;;
        *) printf '%s alert' "$1" ;;
    esac
}

warn_if_automatic_alerts_disabled() {
    if ! is_service_running; then
        echo "IMPORTANT: Automatic alerts are OFF. This rule is saved but will not run."
        echo "Use option 9, then option 1, when you want background alerts enabled."
    fi
}

repeat_display() {
    if [ "$1" = "0" ]; then
        printf 'Until stopped'
    else
        printf '%sx' "$1"
    fi
}

repeat_compact_display() {
    if [ "$1" = "0" ]; then
        printf '∞'
    else
        printf '%sx' "$1"
    fi
}

show_trigger_choices() {
    local level="$1"
    echo "Choose when this voice alert should play:"
    echo ""
    echo "   1) CHARGING ALERT"
    echo "      Use this while the battery is filling up."
    echo "      Starts at ${level}%. Unplug the charger to stop the voice."
    echo ""
    echo "   2) LOW-BATTERY ALERT"
    echo "      Use this while the battery is running down."
    echo "      Starts at ${level}%. Plug in the charger to stop the voice."
}

show_automatic_low_type() {
    local level="$1"
    echo "Alert type: LOW-BATTERY ALERT (automatic below 30%)."
    echo "The voice starts when the battery drops to ${level}%."
    echo "Plug in the charger to stop the voice."
}

prompt_repeat_behavior() {
    local current_repeat="$1" alert_type="$2" result_var="$3"
    local default_choice=1 choice fixed_default stop_action
    [ "$current_repeat" = "0" ] && default_choice=2
    fixed_default="$current_repeat"
    [ "$fixed_default" = "0" ] && fixed_default="${REPEAT_COUNT:-10}"
    if [ "$alert_type" = "LOW" ]; then
        stop_action="plug in the charger"
    else
        stop_action="unplug the charger"
    fi

    echo "   1) Fixed number — speak a set number of times"
    echo "   2) Until stopped — keep speaking until you stop it"
    echo "      Stop with Mute, Volume Down, or $stop_action."
    if ! prompt_number "Choose 1 or 2 (Enter keeps the current choice; 'c' cancels): " 1 2 "$default_choice" choice; then
        return 1
    fi
    if [ "$choice" = "2" ]; then
        eval "$result_var=0"
        return 0
    fi
    prompt_number "How many times? [1-100] (Press Enter for ${fixed_default}, or 'c' to cancel): " 1 100 "$fixed_default" "$result_var"
}

prompt_bulk_repeat_behavior() {
    local fixed_default="$1" result_var="$2"
    local choice

    echo "Repeat behavior for all existing alerts:"
    echo "   1) Fixed number — set every alert to the same repeat count"
    echo "   2) Until stopped — keep every alert speaking until you stop it"
    echo "      Stop with Mute, Volume Down, or the appropriate charger change."
    if ! prompt_number "Choose 1 or 2 (Enter selects Fixed number; 'c' cancels): " 1 2 "1" choice; then
        return 1
    fi
    if [ "$choice" = "2" ]; then
        eval "$result_var=0"
        return 0
    fi
    prompt_number "How many times? [1-100] (Press Enter for ${fixed_default}, or 'c' to cancel): " 1 100 "$fixed_default" "$result_var"
}

set_all_alert_timing() {
    local repeat_count="$1" delay_ms="$2"
    local updated_alerts=()
    local alert

    for alert in "${ALERTS[@]}"; do
        parse_alert_entry "$alert"
        updated_alerts+=("${PARSED_LVL}:${PARSED_TYP}:${repeat_count}:${delay_ms}:${PARSED_MSG}")
    done
    ALERTS=("${updated_alerts[@]}")
}

show_status() {
    load_config || return 1
    local pct="N/A" pwr="Power state unavailable"
    local audio_info="" cur_vol="Unavailable" cur_muted=""
    if get_battery_state; then
        pct="$BATTERY_PERCENT"
        pwr=$(battery_status_label)
    fi
    if audio_info=$(get_audio_settings); then
        read -r cur_vol cur_muted <<< "$audio_info"
        [ "$cur_muted" = "true" ] && cur_vol="${cur_vol}% (muted)" || cur_vol="${cur_vol}%"
    fi

    echo "─── BATTMON STATUS ───────────────────────────────────────────────────────"
    if [ "$pct" = "N/A" ]; then
        printf " Battery               : Not detected (%s)\n" "$pwr"
    else
        printf " Battery               : %-4s (%s)\n" "${pct}%" "$pwr"
    fi
    printf " Current system volume : %s\n" "$cur_vol"
    printf " Volume target         : %s%%\n" "$ALERT_VOLUME"
    printf " Pause playing media   : %s\n" "$([ "$PAUSE_MEDIA" = true ] && echo On || echo Off)"
    printf " Startup quiet period  : %s seconds\n" "$STARTUP_GRACE_SECONDS"
    if is_service_running; then
        echo " Background service    : Running"
    else
        echo " Background service    : STOPPED — automatic alerts are disabled"
    fi
    echo "──────────────────────────────────────────────────────────────────────────"
    if [ -n "$CONFIG_WARNING" ]; then
        printf " Config note: %s\n" "$CONFIG_WARNING"
    fi
    echo " Configured Alert Rules:"
    printf "   %-3s %-5s %-9s %-13s %-9s %s\n" "#" "LVL" "ALERT" "REPEATS" "PAUSE" "SPOKEN MESSAGE"
    local idx=1
    for alert in "${ALERTS[@]}"; do
        parse_alert_entry "$alert"
        local ui_type
        ui_type=$(alert_type_short_name "$PARSED_TYP")
        local trunc_msg="$PARSED_MSG"
        if [ "${#trunc_msg}" -gt 28 ]; then trunc_msg="${trunc_msg:0:25}..."; fi
        printf "  [%2d] %3d%%  %-9s %-13s %-8s \"%s\"\n" "$idx" "$PARSED_LVL" "$ui_type" "$(repeat_display "$PARSED_REP")" "${PARSED_DEL}ms" "$trunc_msg"
        ((idx++))
    done
    echo "──────────────────────────────────────────────────────────────────────────"
}

edit_alert_at_index() {
    local target_idx="$1"
    parse_alert_entry "${ALERTS[$target_idx]}"
    local alert_num=$((target_idx + 1))
    local lvl="$PARSED_LVL"

    echo ""
    echo "─── Editing Alert #$alert_num (${lvl}%) ────────────────────────────────────────"
    echo "Percentage: ${lvl}% (Fixed)"
    echo "──────────────────────────────────────────────────────────────────────────"

    local new_typ message_step repeat_step delay_step
    if is_automatic_low_level "$lvl"; then
        new_typ="LOW"
        message_step=1
        repeat_step=2
        delay_step=3
        show_automatic_low_type "$lvl"
    else
        echo "1. Alert type:"
        show_trigger_choices "$lvl"
        local cur_choice=1
        if [ "$PARSED_TYP" = "LOW" ]; then cur_choice=2; fi
        local trig_sel current_type_name
        current_type_name=$(alert_type_plain_name "$PARSED_TYP")
        if ! prompt_number "Choose 1 or 2 (Enter keeps ${current_type_name}; 'c' cancels): " 1 2 "$cur_choice" trig_sel; then
            return
        fi
        new_typ="HIGH"
        if [ "$trig_sel" = "2" ]; then new_typ="LOW"; fi
        message_step=2
        repeat_step=3
        delay_step=4
    fi

    if ! read -r -p "${message_step}. Spoken message (Press Enter for \"${PARSED_MSG}\", or 'c' to cancel): " new_msg; then
        echo "Input closed; no changes saved."
        return
    fi
    if [ "$new_msg" = "c" ] || [ "$new_msg" = "C" ]; then echo "Cancelled."; return; fi
    new_msg="${new_msg:-$PARSED_MSG}"

    local new_rep
    echo "${repeat_step}. Repeat behavior:"
    if ! prompt_repeat_behavior "$PARSED_REP" "$new_typ" new_rep; then
        return
    fi

    local new_del
    if ! prompt_number "${delay_step}. Pause delay in milliseconds (min 50 ms) (Press Enter for ${PARSED_DEL} ms, or 'c' to cancel): " 50 60000 "$PARSED_DEL" new_del; then
        return
    fi

    ALERTS[$target_idx]="${lvl}:${new_typ}:${new_rep}:${new_del}:${new_msg}"
    save_config || return
    echo "Alert #$alert_num (${lvl}%) updated successfully."
    warn_if_automatic_alerts_disabled
}

edit_alert() {
    load_config
    echo ""
    echo "─── Edit an Existing Alert ───────────────────────────────────────────────"
    local idx=1
    for alert in "${ALERTS[@]}"; do
        parse_alert_entry "$alert"
        local ui_type
        ui_type=$(alert_type_short_name "$PARSED_TYP")
        local trunc_msg="$PARSED_MSG"
        if [ "${#trunc_msg}" -gt 38 ]; then trunc_msg="${trunc_msg:0:35}..."; fi
        printf "  [%d] %3d%% [%-8s] (%s, %sms) -> \"%s\"\n" "$idx" "$PARSED_LVL" "$ui_type" "$(repeat_display "$PARSED_REP")" "$PARSED_DEL" "$trunc_msg"
        ((idx++))
    done
    echo "──────────────────────────────────────────────────────────────────────────"
    local alert_num
    if ! prompt_number "Enter alert number to edit [1-${#ALERTS[@]}] (or 'c' to cancel): " 1 "${#ALERTS[@]}" "" alert_num; then
        return
    fi

    edit_alert_at_index "$((alert_num - 1))"
}

add_alert() {
    load_config
    echo ""
    echo "─── Add New Battery Alert ────────────────────────────────────────────────"

    local new_lvl=""
    local replace_idx=""

    while true; do
        if ! prompt_number "1. Battery percentage [1-100] (e.g. 67, 82) (or 'c' to cancel): " 1 100 "" new_lvl; then
            return
        fi

        # Check if an alert rule for new_lvl already exists
        local match_indices=()
        for i in "${!ALERTS[@]}"; do
            parse_alert_entry "${ALERTS[$i]}"
            if [ "$PARSED_LVL" -eq "$new_lvl" ]; then
                match_indices+=("$i")
            fi
        done

        if [ ${#match_indices[@]} -gt 0 ]; then
            echo ""
            echo "  ⚠️  An alert rule for ${new_lvl}% already exists!"
            echo "  Current settings for this alert:"
            for mi in "${match_indices[@]}"; do
                parse_alert_entry "${ALERTS[$mi]}"
                local type_desc
                type_desc=$(alert_type_plain_name "$PARSED_TYP")
                echo "   • Alert type   : ${type_desc}"
                echo "   • Spoken text  : \"${PARSED_MSG}\""
                echo "   • Repeats      : $(repeat_display "$PARSED_REP")"
                echo "   • Pause delay  : ${PARSED_DEL} ms"
            done
            echo "──────────────────────────────────────────────────────────────────────────"
            echo "  Options:"
            echo "   1) Edit this existing alert"
            echo "   2) Overwrite with new settings"
            echo "   3) Choose a different percentage"
            echo "   4) Cancel & return to menu"

            local conflict_choice
            if ! prompt_number "Enter choice [1-4] (Press Enter for 1, or 'c' to cancel): " 1 4 "1" conflict_choice; then
                return
            fi

            case "$conflict_choice" in
                1)
                    edit_alert_at_index "${match_indices[0]}"
                    return
                    ;;
                2)
                    replace_idx="${match_indices[0]}"
                    break
                    ;;
                3)
                    echo ""
                    continue
                    ;;
                4)
                    return
                    ;;
            esac
        else
            break
        fi
    done

    local new_typ message_step repeat_step delay_step
    if is_automatic_low_level "$new_lvl"; then
        new_typ="LOW"
        message_step=2
        repeat_step=3
        delay_step=4
        echo ""
        show_automatic_low_type "$new_lvl"
    else
        echo "2. Alert type:"
        show_trigger_choices "$new_lvl"
        local trig_choice
        if ! prompt_number "Choose 1 or 2 (Enter selects Charging alert; 'c' cancels): " 1 2 "1" trig_choice; then
            return
        fi
        new_typ="HIGH"
        if [ "$trig_choice" = "2" ]; then new_typ="LOW"; fi
        message_step=3
        repeat_step=4
        delay_step=5
    fi

    if ! read -r -p "${message_step}. Spoken message (Press Enter for 'Battery is at $new_lvl percent', or 'c' to cancel): " new_msg; then
        echo "Input closed; no changes saved."
        return
    fi
    if [ "$new_msg" = "c" ] || [ "$new_msg" = "C" ]; then echo "Cancelled."; return; fi
    if [ -z "$new_msg" ]; then new_msg="Battery is at $new_lvl percent"; fi

    local new_rep
    echo "${repeat_step}. Repeat behavior:"
    if ! prompt_repeat_behavior "${REPEAT_COUNT:-10}" "$new_typ" new_rep; then
        return
    fi

    local new_del
    if ! prompt_number "${delay_step}. Pause delay in milliseconds (minimum 50 ms) (Press Enter for ${REPEAT_DELAY_MS:-100} ms, or 'c' to cancel): " 50 60000 "${REPEAT_DELAY_MS:-100}" new_del; then
        return
    fi

    if [ -n "$replace_idx" ]; then
        ALERTS[$replace_idx]="${new_lvl}:${new_typ}:${new_rep}:${new_del}:${new_msg}"
        save_config || return
        echo "Alert for ${new_lvl}% overwritten successfully."
    else
        ALERTS+=("${new_lvl}:${new_typ}:${new_rep}:${new_del}:${new_msg}")
        save_config || return
        echo "Added alert: ${new_lvl}% ($(alert_type_plain_name "$new_typ")) -> \"${new_msg}\""
    fi
    warn_if_automatic_alerts_disabled
}

delete_alert() {
    load_config
    echo ""
    echo "─── Delete an Alert Rule ─────────────────────────────────────────────────"
    local idx=1
    for alert in "${ALERTS[@]}"; do
        parse_alert_entry "$alert"
        local ui_type
        ui_type=$(alert_type_short_name "$PARSED_TYP")
        local trunc_msg="$PARSED_MSG"
        if [ "${#trunc_msg}" -gt 42 ]; then trunc_msg="${trunc_msg:0:39}..."; fi
        printf "  [%d] %3d%% [%-8s] -> \"%s\"\n" "$idx" "$PARSED_LVL" "$ui_type" "$trunc_msg"
        ((idx++))
    done
    echo "──────────────────────────────────────────────────────────────────────────"
    local alert_num
    if ! prompt_number "Enter number to delete (or 'c' to cancel): " 1 "${#ALERTS[@]}" "" alert_num; then
        return
    fi

    local target_idx=$((alert_num - 1))
    local deleted="${ALERTS[$target_idx]}"
    parse_alert_entry "$deleted"
    local delete_confirm
    if ! read -r -p "Delete ${PARSED_LVL}% $(alert_type_plain_name "$PARSED_TYP") \"${PARSED_MSG}\"? (y/N): " delete_confirm; then
        echo "Input closed; alert kept."
        return
    fi
    case "$delete_confirm" in
        y|Y|yes|YES) ;;
        *) echo "Cancelled; alert kept."; return ;;
    esac
    unset 'ALERTS[target_idx]'
    ALERTS=("${ALERTS[@]}")
    save_config || return
    echo "Deleted: $deleted"
}

edit_timing() {
    load_config
    echo ""
    echo "─── Change Repeat & Pause Delay ──────────────────────────────────────────"
    echo "Current Defaults: Repeat: $REPEAT_COUNT times | Pause: ${REPEAT_DELAY_MS} ms"
    echo "──────────────────────────────────────────────────────────────────────────"

    local new_cnt
    if ! prompt_number "Enter repeat count [1-100] (Press Enter for $REPEAT_COUNT, or 'c' to cancel): " 1 100 "$REPEAT_COUNT" new_cnt; then
        return
    fi
    REPEAT_COUNT="$new_cnt"

    local new_del
    if ! prompt_number "Enter pause delay in milliseconds (minimum 50 ms) (Press Enter for ${REPEAT_DELAY_MS} ms, or 'c' to cancel): " 50 60000 "$REPEAT_DELAY_MS" new_del; then
        return
    fi
    REPEAT_DELAY_MS="$new_del"

    save_config || return
    echo "Default timing updated to ${REPEAT_COUNT}x repeat and ${REPEAT_DELAY_MS} ms pause."

    echo ""
    if ! read -r -p "Apply these settings to existing rules? (y/n) (or 'c' to return): " apply_confirm; then
        echo "Input closed; defaults saved without changing existing rules."
        return
    fi
    if [ "$apply_confirm" = "y" ] || [ "$apply_confirm" = "Y" ] || [ "$apply_confirm" = "yes" ]; then
        local bulk_repeat
        echo ""
        if ! prompt_bulk_repeat_behavior "$new_cnt" bulk_repeat; then
            echo "Defaults were saved; existing rules were not changed."
            return
        fi

        local repeat_summary
        repeat_summary="${bulk_repeat} times"
        [ "$bulk_repeat" = "1" ] && repeat_summary="1 time"
        [ "$bulk_repeat" = "0" ] && repeat_summary="Until stopped"
        if ! read -r -p "Set all ${#ALERTS[@]} existing rules to ${repeat_summary} with a ${new_del} ms pause? (y/N): " apply_confirm; then
            echo "Input closed; existing rules were not changed."
            return
        fi
        case "$apply_confirm" in
            y|Y|yes|YES) ;;
            *) echo "Existing rules were not changed."; return ;;
        esac

        set_all_alert_timing "$bulk_repeat" "$new_del"
        save_config || return
        echo "  [✔] Updated all ${#ALERTS[@]} existing rules: ${repeat_summary}, ${new_del} ms pause."
        read -r -p "Press [Enter] to return (or 'c')..."
    fi
}

apply_timing_to_existing_rules() {
    load_config
    echo ""
    echo "─── Apply Settings to Existing Rules ─────────────────────────────────────"
    echo "Current defaults: Repeat: $REPEAT_COUNT times | Pause: ${REPEAT_DELAY_MS} ms"
    echo "Existing rules to update: ${#ALERTS[@]}"
    echo "──────────────────────────────────────────────────────────────────────────"

    local new_repeat
    if ! prompt_bulk_repeat_behavior "$REPEAT_COUNT" new_repeat; then
        return
    fi

    local new_del
    if ! prompt_number "Enter pause delay in milliseconds (minimum 50 ms) (Press Enter for ${REPEAT_DELAY_MS} ms, or 'c' to cancel): " 50 60000 "$REPEAT_DELAY_MS" new_del; then
        return
    fi

    echo ""
    local repeat_summary
    repeat_summary="${new_repeat} times"
    [ "$new_repeat" = "1" ] && repeat_summary="1 time"
    [ "$new_repeat" = "0" ] && repeat_summary="Until stopped"
    if ! read -r -p "Set all ${#ALERTS[@]} existing rules to ${repeat_summary} with a ${new_del} ms pause? (y/n) (or 'c' to cancel): " confirm; then
        echo "Input closed; no changes saved."
        return
    fi
    if [ "$confirm" = "c" ] || [ "$confirm" = "C" ]; then
        echo "Cancelled."
        return
    fi

    if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ] || [ "$confirm" = "yes" ] || [ -z "$confirm" ]; then
        if [ "$new_repeat" != "0" ]; then
            REPEAT_COUNT="$new_repeat"
        fi
        REPEAT_DELAY_MS="$new_del"
        set_all_alert_timing "$new_repeat" "$new_del"
        save_config || return
        echo "  [✔] Updated all ${#ALERTS[@]} existing rules: ${repeat_summary}, ${new_del} ms pause."
        if [ "$new_repeat" = "0" ]; then
            echo "      The default for newly added alerts remains ${REPEAT_COUNT} times."
        fi
        read -r -p "Press [Enter] to return (or 'c')..."
    else
        echo "Cancelled without modifying existing rules."
    fi
}

edit_volume_settings() {
    load_config
    local audio_info
    local cur_vol="Unavailable" cur_muted=""
    if audio_info=$(get_audio_settings); then
        read -r cur_vol cur_muted <<< "$audio_info"
        [ "$cur_muted" = "true" ] && cur_vol="${cur_vol}% (muted)" || cur_vol="${cur_vol}%"
    fi

    echo ""
    echo "─── Audio & Media Settings ───────────────────────────────────────────────"
    echo "Current system volume: ${cur_vol}"
    echo "Volume target: ${ALERT_VOLUME}%"
    echo "Pause playing media: $([ "$PAUSE_MEDIA" = true ] && echo On || echo Off)"
    echo ""
    echo "Note: If your Mac is on mute or lower than the volume target, Battmon"
    echo "unmutes and temporarily raises it, then automatically restores your"
    echo "exact volume and mute state when done."
    echo "It can also pause Music, Spotify, or QuickTime Player before an alert,"
    echo "then restore the volume and resume only the media it paused."
    echo "──────────────────────────────────────────────────────────────────────────"

    local new_v
    if ! prompt_number "Enter volume target % [1-100] (Press Enter for ${ALERT_VOLUME}%, or 'c' to cancel): " 1 100 "$ALERT_VOLUME" new_v; then
        return
    fi
    ALERT_VOLUME="$new_v"
    RESTORE_VOLUME=true

    local media_choice media_default="y"
    [ "$PAUSE_MEDIA" = "false" ] && media_default="n"
    while true; do
        if ! read -r -p "Pause playing media during alerts? [y/n] (Enter keeps current; 'c' cancels): " media_choice; then
            echo "Input closed; no changes saved."
            return
        fi
        media_choice=$(echo "$media_choice" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
        [ -z "$media_choice" ] && media_choice="$media_default"
        case "$media_choice" in
            y|yes) PAUSE_MEDIA=true; break ;;
            n|no) PAUSE_MEDIA=false; break ;;
            c) echo "Cancelled."; return ;;
            *) echo "Please enter y or n (or 'c' to cancel)." ;;
        esac
    done

    save_config || return
    echo "Audio settings updated: target ${ALERT_VOLUME}%; pause media $([ "$PAUSE_MEDIA" = true ] && echo on || echo off)."
}

