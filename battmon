#!/bin/bash
# ==============================================================================
# BATTMON: macOS Battery Voice Monitor & Interactive Manager
# Universal for any macOS machine. Standard 80x24 terminal friendly.
# ==============================================================================

# Resolve symlink to locate the real directory containing battmon
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

COMMON_FILE="$SCRIPT_DIR/battmon_common.sh"
if [ ! -f "$COMMON_FILE" ]; then
    printf 'Battmon: missing %s\n' "$COMMON_FILE" >&2
    exit 2
fi
source "$COMMON_FILE" || exit 2

RUNTIME_DIR="$BATTMON_RUNTIME_DIR"
RUNTIME_CONFIG="$BATTMON_CONFIG_FILE"
PACKAGE_CONFIG="$BATTMON_TEMPLATE_CONFIG"
CONFIG_FILE="$BATTMON_CONFIG_FILE"
PLIST_DST="$BATTMON_PLIST"
LOG_FILE="$BATTMON_LOG_FILE"
STATE_FILE="$BATTMON_STATE_FILE"

show_help() {
    cat << EOF
─── BATTMON 🦇 macOS Battery Voice Monitor ───────────────────────────────
Usage: battmon [command|option]

Commands:
  battmon              Open interactive number-based terminal GUI
  battmon -h, --help   Show this help manual and exit
  battmon status       Show battery level, volume target & alert rules
  battmon test         Test voice alerts, charger cutoff & keyboard keys
  battmon run          Trigger an immediate battery evaluation cycle
  battmon start/stop   Start or stop background monitor
  battmon restart      Restart background service and refresh config
  battmon edit         Open battery_config.sh in text editor
  battmon doctor       Run read-only installation and runtime checks
  battmon migrate      Validate and safely rewrite the active config

Silencing Shortcuts:
  • Plug in or unplug your charger to stop an active alert immediately.
  • Press MUTE (F10) on keyboard to silence alert immediately.
  • Press VOLUME DOWN (F11) on keyboard to silence alert immediately.

Files:
  Config : ~/.battmon/battery_config.sh
  Logs   : ~/Library/Logs/Battmon/battmon.log
──────────────────────────────────────────────────────────────────────────
EOF
}

if ! load_config; then
    printf 'Battmon: using safe built-in defaults because configuration loading failed.\n' >&2
    set_builtin_defaults
fi

sync_runtime_files() {
    ensure_runtime_dirs || return 1
    [ "$SCRIPT_DIR" = "$RUNTIME_DIR" ] && return 0

    local file source_path temp_path mode
    for file in battmon battery_monitor.sh battmon_common.sh; do
        source_path="$SCRIPT_DIR/$file"
        [ -f "$source_path" ] || {
            printf 'Battmon: missing installation file %s\n' "$source_path" >&2
            return 1
        }
        temp_path=$(mktemp "$RUNTIME_DIR/.${file}.XXXXXX") || return 1
        if ! cp "$source_path" "$temp_path"; then
            rm -f "$temp_path"
            return 1
        fi
        mode=755
        [ "$file" = "battmon_common.sh" ] && mode=644
        chmod "$mode" "$temp_path" || {
            rm -f "$temp_path"
            return 1
        }
        mv -f "$temp_path" "$RUNTIME_DIR/$file" || return 1
    done
}

is_service_running() {
    local uid_value
    uid_value=$(id -u)
    launchctl print "gui/${uid_value}/${BATTMON_LABEL}" >/dev/null 2>&1
}

write_launch_agent() {
    local plist_dir temp_plist
    plist_dir=$(dirname "$PLIST_DST")
    mkdir -p "$plist_dir" "$BATTMON_LOG_DIR" || return 1
    temp_plist=$(mktemp "$plist_dir/.com.battery.batmon.XXXXXX") || return 1
    cat << EOF > "$temp_plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.battery.batmon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>$HOME/.battmon/battery_monitor.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>$BATTMON_LOG_FILE</string>
    <key>StandardErrorPath</key>
    <string>$BATTMON_LOG_FILE</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
EOF
    if ! plutil -lint "$temp_plist" >/dev/null; then
        rm -f "$temp_plist"
        printf 'Battmon: generated LaunchAgent is invalid.\n' >&2
        return 1
    fi
    chmod 600 "$temp_plist" || {
        rm -f "$temp_plist"
        return 1
    }
    mv -f "$temp_plist" "$PLIST_DST"
}

service_install() {
    local uid_value
    uid_value=$(id -u)
    ensure_active_config || return 1
    load_config || return 1
    save_config >/dev/null || return 1
    sync_runtime_files || return 1
    install_symlinks || return 1
    write_launch_agent || return 1

    launchctl bootout "gui/${uid_value}/${BATTMON_LABEL}" >/dev/null 2>&1 || true
    if ! launchctl bootstrap "gui/${uid_value}" "$PLIST_DST"; then
        printf 'Battmon: LaunchAgent failed to load.\n' >&2
        return 1
    fi
    if ! is_service_running; then
        printf 'Battmon: LaunchAgent loaded but could not be verified.\n' >&2
        return 1
    fi
    echo "Background monitor is active and will run after login."
}

service_stop() {
    local uid_value
    uid_value=$(id -u)
    if ! is_service_running; then
        echo "Background monitor is already stopped."
        return 0
    fi
    if ! launchctl bootout "gui/${uid_value}/${BATTMON_LABEL}"; then
        printf 'Battmon: background monitor could not be stopped.\n' >&2
        return 1
    fi
    echo "Background monitor stopped."
}

service_start() {
    service_install
}

service_restart() {
    service_stop || return 1
    service_start
}

install_symlinks() {
    local bindir="$HOME/.local/bin" link_path="$HOME/.local/bin/battmon" target=""
    mkdir -p "$bindir" || return 1
    if [ -e "$link_path" ] || [ -L "$link_path" ]; then
        if [ -L "$link_path" ]; then
            target=$(readlink "$link_path")
            case "$target" in
                "$RUNTIME_DIR/battmon"|"$SCRIPT_DIR/battmon") ;;
                *)
                    printf 'Battmon: refusing to replace existing command %s -> %s\n' "$link_path" "$target" >&2
                    return 1
                    ;;
            esac
        else
            printf 'Battmon: refusing to replace existing file %s\n' "$link_path" >&2
            return 1
        fi
    fi
    ln -sfn "$RUNTIME_DIR/battmon" "$link_path"
}

prompt_number() {
    local prompt_msg="$1"
    local min_val="$2"
    local max_val="$3"
    local default_val="$4"
    local result_var="$5"

    while true; do
        if ! read -r -p "$prompt_msg" input_val; then
            echo ""
            echo "Input closed; returning."
            return 1
        fi
        input_val=$(echo "$input_val" | tr -d '[:space:]')

        if [ "$input_val" = "c" ] || [ "$input_val" = "C" ]; then
            echo "Cancelled."
            return 1
        fi

        if [ -z "$input_val" ] && [ -n "$default_val" ]; then
            eval "$result_var=\"$default_val\""
            return 0
        fi

        if [[ "$input_val" =~ ^[0-9]+$ ]]; then
            if [ -n "$min_val" ] && [ "$input_val" -lt "$min_val" ]; then
                echo "Please enter a number that is at least $min_val (or 'c' to cancel)."
                continue
            fi
            if [ -n "$max_val" ] && [ "$input_val" -gt "$max_val" ]; then
                echo "Please enter a number that is at most $max_val (or 'c' to cancel)."
                continue
            fi
            eval "$result_var=\"$input_val\""
            return 0
        else
            echo "Please enter numbers only (e.g. 10), or 'c' to cancel."
        fi
    done
}

show_status() {
    load_config || return 1
    local pct="N/A" pwr="Power state unavailable"
    local audio_info="" cur_vol="Unavailable" cur_muted=""
    if get_battery_state; then
        pct="$BATTERY_PERCENT"
        pwr=$(battery_status_label)
    fi
    if audio_info=$(get_audio_settings); then
        read -r cur_vol cur_muted <<< "$audio_info"
        [ "$cur_muted" = "true" ] && cur_vol="${cur_vol}% (muted)" || cur_vol="${cur_vol}%"
    fi

    echo "─── BATTMON STATUS ───────────────────────────────────────────────────────"
    if [ "$pct" = "N/A" ]; then
        printf " Battery               : Not detected (%s)\n" "$pwr"
    else
        printf " Battery               : %-4s (%s)\n" "${pct}%" "$pwr"
    fi
    printf " Current system volume : %s\n" "$cur_vol"
    printf " Volume target         : %s%%\n" "$ALERT_VOLUME"
    printf " Background service    : %s\n" "$(is_service_running && echo Running || echo Stopped)"
    echo "──────────────────────────────────────────────────────────────────────────"
    if [ -n "$CONFIG_WARNING" ]; then
        printf " Config note: %s\n" "$CONFIG_WARNING"
    fi
    echo " Configured Alert Rules:"
    printf "   %-3s %-5s %-6s %-7s %-9s %s\n" "#" "LVL" "TYPE" "REPEATS" "PAUSE" "SPOKEN MESSAGE"
    local idx=1
    for alert in "${ALERTS[@]}"; do
        parse_alert_entry "$alert"
        local trunc_msg="$PARSED_MSG"
        if [ "${#trunc_msg}" -gt 34 ]; then trunc_msg="${trunc_msg:0:31}..."; fi
        printf "  [%2d] %3d%%  %-5s  %-6s  %-7s  \"%s\"\n" "$idx" "$PARSED_LVL" "$PARSED_TYP" "${PARSED_REP}x" "${PARSED_DEL}ms" "$trunc_msg"
        ((idx++))
    done
    echo "──────────────────────────────────────────────────────────────────────────"
}

edit_alert_at_index() {
    local target_idx="$1"
    parse_alert_entry "${ALERTS[$target_idx]}"
    local alert_num=$((target_idx + 1))
    local lvl="$PARSED_LVL"

    echo ""
    echo "─── Editing Alert #$alert_num (${lvl}%) ────────────────────────────────────────"
    echo "Percentage: ${lvl}% (Fixed)"
    echo "──────────────────────────────────────────────────────────────────────────"

    echo "1. Trigger condition:"
    echo "   1) HIGH (triggers while charging up to ${lvl}%; stops when unplugged)"
    echo "   2) LOW  (triggers on battery draining to ${lvl}%; stops when plugged in)"
    local cur_choice=1
    if [ "$PARSED_TYP" = "LOW" ]; then cur_choice=2; fi
    local trig_sel
    if ! prompt_number "Enter choice [1 or 2] (Press Enter for $cur_choice, or 'c' to cancel): " 1 2 "$cur_choice" trig_sel; then
        return
    fi
    local new_typ="HIGH"
    if [ "$trig_sel" = "2" ]; then new_typ="LOW"; fi

    if ! read -r -p "2. Spoken message (Press Enter for \"${PARSED_MSG}\", or 'c' to cancel): " new_msg; then
        echo "Input closed; no changes saved."
        return
    fi
    if [ "$new_msg" = "c" ] || [ "$new_msg" = "C" ]; then echo "Cancelled."; return; fi
    new_msg="${new_msg:-$PARSED_MSG}"

    local new_rep
    if ! prompt_number "3. Repeat count [1-100] (Press Enter for ${PARSED_REP}, or 'c' to cancel): " 1 100 "$PARSED_REP" new_rep; then
        return
    fi

    local new_del
    if ! prompt_number "4. Pause delay in milliseconds (min 50 ms) (Press Enter for ${PARSED_DEL} ms, or 'c' to cancel): " 50 60000 "$PARSED_DEL" new_del; then
        return
    fi

    ALERTS[$target_idx]="${lvl}:${new_typ}:${new_rep}:${new_del}:${new_msg}"
    save_config || return
    echo "Alert #$alert_num (${lvl}%) updated successfully."
}

edit_alert() {
    load_config
    echo ""
    echo "─── Edit an Existing Alert ───────────────────────────────────────────────"
    local idx=1
    for alert in "${ALERTS[@]}"; do
        parse_alert_entry "$alert"
        local trunc_msg="$PARSED_MSG"
        if [ "${#trunc_msg}" -gt 38 ]; then trunc_msg="${trunc_msg:0:35}..."; fi
        printf "  [%d] %3d%% [%-4s] (%sx, %sms) -> \"%s\"\n" "$idx" "$PARSED_LVL" "$PARSED_TYP" "$PARSED_REP" "$PARSED_DEL" "$trunc_msg"
        ((idx++))
    done
    echo "──────────────────────────────────────────────────────────────────────────"
    local alert_num
    if ! prompt_number "Enter alert number to edit [1-${#ALERTS[@]}] (or 'c' to cancel): " 1 "${#ALERTS[@]}" "" alert_num; then
        return
    fi

    edit_alert_at_index "$((alert_num - 1))"
}

add_alert() {
    load_config
    echo ""
    echo "─── Add New Battery Alert ────────────────────────────────────────────────"

    local new_lvl=""
    local replace_idx=""

    while true; do
        if ! prompt_number "1. Battery percentage [1-100] (e.g. 67, 82) (or 'c' to cancel): " 1 100 "" new_lvl; then
            return
        fi

        # Check if an alert rule for new_lvl already exists
        local match_indices=()
        for i in "${!ALERTS[@]}"; do
            parse_alert_entry "${ALERTS[$i]}"
            if [ "$PARSED_LVL" -eq "$new_lvl" ]; then
                match_indices+=("$i")
            fi
        done

        if [ ${#match_indices[@]} -gt 0 ]; then
            echo ""
            echo "  ⚠️  An alert rule for ${new_lvl}% already exists!"
            echo "  Current settings for this alert:"
            for mi in "${match_indices[@]}"; do
                parse_alert_entry "${ALERTS[$mi]}"
                local type_desc="Charging"
                if [ "$PARSED_TYP" = "LOW" ]; then type_desc="On Battery / Discharging"; fi
                echo "   • Type         : ${PARSED_TYP} (${type_desc})"
                echo "   • Spoken text  : \"${PARSED_MSG}\""
                echo "   • Repeat count : ${PARSED_REP} times"
                echo "   • Pause delay  : ${PARSED_DEL} ms"
            done
            echo "──────────────────────────────────────────────────────────────────────────"
            echo "  Options:"
            echo "   1) Edit this existing alert"
            echo "   2) Overwrite with new settings"
            echo "   3) Choose a different percentage"
            echo "   4) Cancel & return to menu"

            local conflict_choice
            if ! prompt_number "Enter choice [1-4] (Press Enter for 1, or 'c' to cancel): " 1 4 "1" conflict_choice; then
                return
            fi

            case "$conflict_choice" in
                1)
                    edit_alert_at_index "${match_indices[0]}"
                    return
                    ;;
                2)
                    replace_idx="${match_indices[0]}"
                    break
                    ;;
                3)
                    echo ""
                    continue
                    ;;
                4)
                    return
                    ;;
            esac
        else
            break
        fi
    done

    echo "2. Trigger condition:"
    echo "   1) HIGH (triggers while charging up to this %; stops when unplugged)"
    echo "   2) LOW  (triggers on battery draining to this %; stops when plugged in)"
    local trig_choice
    if ! prompt_number "Enter choice [1 or 2] (Press Enter for 1, or 'c' to cancel): " 1 2 "1" trig_choice; then
        return
    fi
    local new_typ="HIGH"
    if [ "$trig_choice" = "2" ]; then new_typ="LOW"; fi

    if ! read -r -p "3. Spoken message (Press Enter for 'Battery is at $new_lvl percent', or 'c' to cancel): " new_msg; then
        echo "Input closed; no changes saved."
        return
    fi
    if [ "$new_msg" = "c" ] || [ "$new_msg" = "C" ]; then echo "Cancelled."; return; fi
    if [ -z "$new_msg" ]; then new_msg="Battery is at $new_lvl percent"; fi

    local new_rep
    if ! prompt_number "4. How many times to repeat? (Press Enter for ${REPEAT_COUNT:-10}, or 'c' to cancel): " 1 100 "${REPEAT_COUNT:-10}" new_rep; then
        return
    fi

    local new_del
    if ! prompt_number "5. Pause delay in milliseconds (minimum 50 ms) (Press Enter for ${REPEAT_DELAY_MS:-100} ms, or 'c' to cancel): " 50 60000 "${REPEAT_DELAY_MS:-100}" new_del; then
        return
    fi

    if [ -n "$replace_idx" ]; then
        ALERTS[$replace_idx]="${new_lvl}:${new_typ}:${new_rep}:${new_del}:${new_msg}"
        save_config || return
        echo "Alert for ${new_lvl}% overwritten successfully."
    else
        ALERTS+=("${new_lvl}:${new_typ}:${new_rep}:${new_del}:${new_msg}")
        save_config || return
        echo "Added alert: ${new_lvl}% (${new_typ}) -> \"${new_msg}\""
    fi
}

delete_alert() {
    load_config
    echo ""
    echo "─── Delete an Alert Rule ─────────────────────────────────────────────────"
    local idx=1
    for alert in "${ALERTS[@]}"; do
        parse_alert_entry "$alert"
        local trunc_msg="$PARSED_MSG"
        if [ "${#trunc_msg}" -gt 42 ]; then trunc_msg="${trunc_msg:0:39}..."; fi
        printf "  [%d] %3d%% [%-4s] -> \"%s\"\n" "$idx" "$PARSED_LVL" "$PARSED_TYP" "$trunc_msg"
        ((idx++))
    done
    echo "──────────────────────────────────────────────────────────────────────────"
    local alert_num
    if ! prompt_number "Enter number to delete (or 'c' to cancel): " 1 "${#ALERTS[@]}" "" alert_num; then
        return
    fi

    local target_idx=$((alert_num - 1))
    local deleted="${ALERTS[$target_idx]}"
    parse_alert_entry "$deleted"
    local delete_confirm
    if ! read -r -p "Delete ${PARSED_LVL}% ${PARSED_TYP} alert \"${PARSED_MSG}\"? (y/N): " delete_confirm; then
        echo "Input closed; alert kept."
        return
    fi
    case "$delete_confirm" in
        y|Y|yes|YES) ;;
        *) echo "Cancelled; alert kept."; return ;;
    esac
    unset 'ALERTS[target_idx]'
    ALERTS=("${ALERTS[@]}")
    save_config || return
    echo "Deleted: $deleted"
}

edit_timing() {
    load_config
    echo ""
    echo "─── Change Repeat & Pause Delay ──────────────────────────────────────────"
    echo "Current Defaults: Repeat: $REPEAT_COUNT times | Pause: ${REPEAT_DELAY_MS} ms"
    echo "──────────────────────────────────────────────────────────────────────────"

    local new_cnt
    if ! prompt_number "Enter repeat count [1-100] (Press Enter for $REPEAT_COUNT, or 'c' to cancel): " 1 100 "$REPEAT_COUNT" new_cnt; then
        return
    fi
    REPEAT_COUNT="$new_cnt"

    local new_del
    if ! prompt_number "Enter pause delay in milliseconds (minimum 50 ms) (Press Enter for ${REPEAT_DELAY_MS} ms, or 'c' to cancel): " 50 60000 "$REPEAT_DELAY_MS" new_del; then
        return
    fi
    REPEAT_DELAY_MS="$new_del"

    save_config || return
    echo "Default timing updated to ${REPEAT_COUNT}x repeat and ${REPEAT_DELAY_MS} ms pause."

    echo ""
    if ! read -r -p "Apply these settings to existing rules? (y/n) (or 'c' to return): " apply_confirm; then
        echo "Input closed; defaults saved without changing existing rules."
        return
    fi
    if [ "$apply_confirm" = "y" ] || [ "$apply_confirm" = "Y" ] || [ "$apply_confirm" = "yes" ]; then
        local updated_alerts=()
        for alert in "${ALERTS[@]}"; do
            parse_alert_entry "$alert"
            updated_alerts+=("${PARSED_LVL}:${PARSED_TYP}:${new_cnt}:${new_del}:${PARSED_MSG}")
        done
        ALERTS=("${updated_alerts[@]}")
        save_config || return
        echo "  [✔] Applied ${new_cnt}x repeat and ${new_del} ms pause to all ${#ALERTS[@]} existing alert rules!"
        read -r -p "Press [Enter] to return (or 'c')..."
    fi
}

apply_timing_to_existing_rules() {
    load_config
    echo ""
    echo "─── Apply Settings to Existing Rules ─────────────────────────────────────"
    echo "Current settings: Repeat: $REPEAT_COUNT times | Pause: ${REPEAT_DELAY_MS} ms"
    echo "Existing rules to update: ${#ALERTS[@]}"
    echo "──────────────────────────────────────────────────────────────────────────"

    local new_cnt
    if ! prompt_number "Enter repeat count [1-100] (Press Enter for $REPEAT_COUNT, or 'c' to cancel): " 1 100 "$REPEAT_COUNT" new_cnt; then
        return
    fi

    local new_del
    if ! prompt_number "Enter pause delay in milliseconds (minimum 50 ms) (Press Enter for ${REPEAT_DELAY_MS} ms, or 'c' to cancel): " 50 60000 "$REPEAT_DELAY_MS" new_del; then
        return
    fi

    echo ""
    if ! read -r -p "Apply ${new_cnt}x repeat and ${new_del} ms pause to all ${#ALERTS[@]} rules? (y/n) (or 'c' to cancel): " confirm; then
        echo "Input closed; no changes saved."
        return
    fi
    if [ "$confirm" = "c" ] || [ "$confirm" = "C" ]; then
        echo "Cancelled."
        return
    fi

    if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ] || [ "$confirm" = "yes" ] || [ -z "$confirm" ]; then
        REPEAT_COUNT="$new_cnt"
        REPEAT_DELAY_MS="$new_del"
        local updated_alerts=()
        for alert in "${ALERTS[@]}"; do
            parse_alert_entry "$alert"
            updated_alerts+=("${PARSED_LVL}:${PARSED_TYP}:${new_cnt}:${new_del}:${PARSED_MSG}")
        done
        ALERTS=("${updated_alerts[@]}")
        save_config || return
        echo "  [✔] Applied ${new_cnt}x repeat and ${new_del} ms pause to all ${#ALERTS[@]} alert rules!"
        read -r -p "Press [Enter] to return (or 'c')..."
    else
        echo "Cancelled without modifying existing rules."
    fi
}

edit_volume_settings() {
    load_config
    local audio_info
    local cur_vol="Unavailable" cur_muted=""
    if audio_info=$(get_audio_settings); then
        read -r cur_vol cur_muted <<< "$audio_info"
        [ "$cur_muted" = "true" ] && cur_vol="${cur_vol}% (muted)" || cur_vol="${cur_vol}%"
    fi

    echo ""
    echo "─── Volume Target Settings ───────────────────────────────────────────────"
    echo "Current system volume: ${cur_vol}"
    echo "Volume target: ${ALERT_VOLUME}%"
    echo ""
    echo "Note: If your Mac is on mute or lower than the volume target, Battmon"
    echo "unmutes and temporarily raises it, then automatically restores your"
    echo "exact volume and mute state when done."
    echo "──────────────────────────────────────────────────────────────────────────"

    local new_v
    if ! prompt_number "Enter volume target % [1-100] (Press Enter for ${ALERT_VOLUME}%, or 'c' to cancel): " 1 100 "$ALERT_VOLUME" new_v; then
        return
    fi
    ALERT_VOLUME="$new_v"
    RESTORE_VOLUME=true

    save_config || return
    echo "Volume target updated to ${ALERT_VOLUME}%."
}

reset_defaults() {
    echo ""
    echo "─── Reset Everything to Default ──────────────────────────────────────────"
    echo "This will reset all alert rules, repeat count, delays, and volume target"
    echo "back to the factory recommended defaults."
    if ! read -r -p "Are you sure you want to reset everything? (y/n) [or 'c' to cancel]: " confirm; then
        echo "Input closed; settings kept."
        return
    fi
    if [ "$confirm" = "c" ] || [ "$confirm" = "C" ]; then
        echo "Cancelled."
        return
    fi
    if [[ "$confirm" =~ ^[Yy] ]]; then
        set_builtin_defaults
        save_config || return
        echo "All settings have been reset to default!"
        read -r -p "Press [Enter] to return (or 'c')..."
    else
        echo "Reset cancelled."
    fi
}

TEST_SAY_PID=""
TEST_ORIG_VOL=""
TEST_ORIG_MUTED=""
TEST_AUDIO_MODIFIED=0

cleanup_voice_test() {
    if [ -n "$TEST_SAY_PID" ] && kill -0 "$TEST_SAY_PID" 2>/dev/null; then
        kill -TERM "$TEST_SAY_PID" 2>/dev/null || true
        wait "$TEST_SAY_PID" 2>/dev/null || true
    fi
    TEST_SAY_PID=""
    if [ "$TEST_AUDIO_MODIFIED" -eq 1 ]; then
        restore_sys_audio "$TEST_ORIG_VOL" "$TEST_ORIG_MUTED" || printf 'Warning: audio state could not be restored.\n' >&2
        TEST_AUDIO_MODIFIED=0
    fi
}

prepare_voice_test() {
    local settings
    settings=$(get_audio_settings) || {
        echo "Audio settings are unavailable; test cancelled."
        return 1
    }
    read -r TEST_ORIG_VOL TEST_ORIG_MUTED <<< "$settings"
    TEST_AUDIO_MODIFIED=0
    if [ "$TEST_ORIG_MUTED" = "true" ]; then
        set_sys_muted false || return 1
        TEST_AUDIO_MODIFIED=1
    fi
    if [ "$TEST_ORIG_VOL" -lt "$ALERT_VOLUME" ]; then
        set_sys_volume "$ALERT_VOLUME" || {
            cleanup_voice_test
            return 1
        }
        TEST_AUDIO_MODIFIED=1
    fi
    trap 'cleanup_voice_test; exit 130' INT
    trap 'cleanup_voice_test; exit 143' TERM
    trap 'cleanup_voice_test; exit 129' HUP
}

finish_voice_test() {
    cleanup_voice_test
    trap - INT TERM HUP
}

speak_test_once() {
    local message="$1"
    prepare_voice_test || return 1
    echo "Speaking: \"$message\"..."
    say "$message"
    local result=$?
    finish_voice_test
    return "$result"
}

run_interrupt_test() {
    local mode="$1" message="$2" start_source active_volume check_seconds settings current_volume current_muted index
    get_battery_state || {
        echo "Battery status is unavailable; test cancelled."
        return 1
    }
    start_source="$BATTERY_SOURCE"
    prepare_voice_test || return 1
    active_volume="$TEST_ORIG_VOL"
    [ "$active_volume" -lt "$ALERT_VOLUME" ] && active_volume="$ALERT_VOLUME"
    check_seconds=$(awk -v ms="$CHECK_INTERVAL_MS" 'BEGIN { printf "%.3f", ms / 1000 }')

    index=1
    while [ "$index" -le 10 ]; do
        echo "[Repetition $index/10] Change charger state or press Mute/Volume Down."
        say "$message" &
        TEST_SAY_PID=$!
        while kill -0 "$TEST_SAY_PID" 2>/dev/null; do
            if get_battery_state; then
                if [ "$mode" = "charger" ] && [ "$BATTERY_SOURCE" != "$start_source" ]; then
                    echo ">>> SUCCESS: power-source change detected immediately."
                    finish_voice_test
                    return 0
                fi
            fi
            if settings=$(get_audio_settings); then
                read -r current_volume current_muted <<< "$settings"
                if [ "$current_muted" = "true" ] || [ "$current_volume" -lt "$active_volume" ]; then
                    echo ">>> SUCCESS: hardware audio change detected immediately."
                    TEST_AUDIO_MODIFIED=0
                    finish_voice_test
                    return 0
                fi
            fi
            sleep "$check_seconds"
        done
        wait "$TEST_SAY_PID" 2>/dev/null || true
        TEST_SAY_PID=""
        sleep 0.1
        index=$((index + 1))
    done
    finish_voice_test
    echo "Test completed without an interruption."
}

test_voice_interruption() {
    load_config || return
    echo ""
    echo "─── Test Voice & Silencing Cutoffs ───────────────────────────────────────"
    echo "  1) Speak a custom word or phrase once"
    echo "  2) Speak an existing alert phrase once"
    echo "  3) Test charger cutoff"
    echo "  4) Test keyboard Mute or Volume Down cutoff"
    echo "  5) Return to Main Menu"
    echo "──────────────────────────────────────────────────────────────────────────"
    local tchoice custom_phrase idx=1 midx start_key
    if ! prompt_number "Enter choice [1-5] (or 'c' to cancel): " 1 5 "5" tchoice; then
        return
    fi

    case "$tchoice" in
        1)
            if ! read -r -p "Phrase to say (or 'c' to cancel): " custom_phrase; then return; fi
            [ "$custom_phrase" = "c" ] || [ "$custom_phrase" = "C" ] || [ -z "$custom_phrase" ] || speak_test_once "$custom_phrase"
            ;;
        2)
            for alert in "${ALERTS[@]}"; do
                parse_alert_entry "$alert"
                printf "  [%d] \"%s\"\n" "$idx" "$PARSED_MSG"
                idx=$((idx + 1))
            done
            if ! prompt_number "Choose message number [1-${#ALERTS[@]}] (or 'c' to cancel): " 1 "${#ALERTS[@]}" "" midx; then return; fi
            parse_alert_entry "${ALERTS[$((midx - 1))]}"
            speak_test_once "$PARSED_MSG"
            ;;
        3|4)
            if ! read -r -p "Press [Enter] to begin (or 'c' to cancel): " start_key; then return; fi
            [ "$start_key" = "c" ] || [ "$start_key" = "C" ] || run_interrupt_test "$([ "$tchoice" = "3" ] && echo charger || echo audio)" "Charge up your battery now"
            ;;
        5) return ;;
    esac
}

service_menu() {
    while true; do
        echo ""
        echo "─── Background Service Controls ──────────────────────────────────────────"
        echo "  1) Start background service (auto-starts on boot)"
        echo "  2) Stop background service"
        echo "  3) Restart service"
        echo "  4) Trigger one immediate battery check now"
        echo "  5) Return to Main Menu"
        echo "──────────────────────────────────────────────────────────────────────────"
        local schoice
        if ! prompt_number "Enter choice [1-5] (or 'c' to cancel): " 1 5 "5" schoice; then
            return
        fi

        case "$schoice" in
            1) service_install ;;
            2) service_stop ;;
            3) service_restart ;;
            4)
                echo "Running monitor check..."
                ensure_active_config && sync_runtime_files && /bin/bash "$RUNTIME_DIR/battery_monitor.sh"
                local monitor_result=$?
                if [ "$monitor_result" -eq 0 ]; then
                    echo "Monitor check completed."
                else
                    echo "Monitor check failed with exit code $monitor_result."
                fi
                ;;
            5) break ;;
        esac
    done
}

main_menu() {
    while true; do
        load_config || {
            echo "Configuration is invalid. Run 'battmon doctor' for details."
            return 1
        }
        local pct="N/A" pwr="Power unavailable" audio_info="" cur_v="N/A" cur_muted=""
        if get_battery_state; then
            pct="$BATTERY_PERCENT"
            pwr=$(battery_status_label)
        fi
        if audio_info=$(get_audio_settings); then
            read -r cur_v cur_muted <<< "$audio_info"
            [ "$cur_muted" = "true" ] && cur_v="${cur_v}M"
        fi

        clear 2>/dev/null || echo ""
        echo "─── BATTMON 🦇 Battery Voice Monitor ─────────────────────────────────────"
        local bat_str=" Battery: ${pct}% (${pwr})"
        [ "$pct" = "N/A" ] && bat_str=" Battery: Not detected"
        local vol_str=" Volume target: ${ALERT_VOLUME}%"
        printf "%-36s | Current volume: %s\n" "$bat_str" "${cur_v}"
        printf "%-36s | Silencing: Charger or MUTE/VOL-DOWN\n" "$vol_str"
        echo "──────────────────────────────────────────────────────────────────────────"
        echo " Configured Alerts:"
        local idx=0
        local max_preview=6
        for alert in "${ALERTS[@]}"; do
            ((idx++))
            if [ $idx -gt $max_preview ] && [ "${#ALERTS[@]}" -gt $max_preview ]; then
                local remain=$((${#ALERTS[@]} - max_preview))
                printf "    (... and %d more alerts - view all via option 4)\n" "$remain"
                break
            fi
            parse_alert_entry "$alert"
            local trunc_msg="$PARSED_MSG"
            if [ "${#trunc_msg}" -gt 33 ]; then trunc_msg="${trunc_msg:0:30}..."; fi
            printf "  • %3d%% [%-4s] %2sx %4sms \"%s\"\n" "$PARSED_LVL" "$PARSED_TYP" "$PARSED_REP" "$PARSED_DEL" "$trunc_msg"
        done
        echo "──────────────────────────────────────────────────────────────────────────"
        printf "  1) Edit an alert rule            7) Change volume target\n"
        printf "  2) Add new battery alert         8) Test voice & silencing keys\n"
        printf "  3) Delete an alert rule          9) Background service controls\n"
        printf "  4) View all alerts & status     10) Reset everything to default\n"
        printf "  5) Change repeat & pause delay  11) Exit Battmon\n"
        printf "  6) Apply to existing rules\n"
        echo "──────────────────────────────────────────────────────────────────────────"
        if ! read -r -p " Enter choice [1-11] (or 'c' to exit): " choice; then
            echo ""
            echo "Input closed. Goodbye!"
            return 0
        fi

        if [ "$choice" = "c" ] || [ "$choice" = "C" ]; then
            echo "Goodbye!"
            exit 0
        fi

        case "$choice" in
            1) edit_alert ;;
            2) add_alert ;;
            3) delete_alert ;;
            4)
                show_status
                read -r -p "Press [Enter] to return (or 'c')..."
                ;;
            5) edit_timing ;;
            6) apply_timing_to_existing_rules ;;
            7) edit_volume_settings ;;
            8) test_voice_interruption ;;
            9) service_menu ;;
            10) reset_defaults ;;
            11)
                echo "Goodbye!"
                exit 0
                ;;
            *)
                echo "Please enter a number between 1 and 11 (or 'c' to exit)."
                sleep 0.8
                ;;
        esac
    done
}

doctor() {
    local failures=0 command_name settings
    echo "─── BATTMON DOCTOR ───────────────────────────────────────────────────────"
    if [ "$(uname -s)" = "Darwin" ]; then
        echo " [OK] macOS detected"
    else
        echo " [FAIL] Battmon requires macOS"
        failures=$((failures + 1))
    fi
    for command_name in pmset say launchctl osascript awk sed sort mktemp plutil; do
        if command -v "$command_name" >/dev/null 2>&1; then
            printf ' [OK] %s\n' "$command_name"
        else
            printf ' [FAIL] Missing built-in command: %s\n' "$command_name"
            failures=$((failures + 1))
        fi
    done
    if load_config; then
        printf ' [OK] Config valid (%d normalized rules)\n' "${#ALERTS[@]}"
        [ -n "$CONFIG_WARNING" ] && printf ' [WARN] %s\n' "$CONFIG_WARNING"
    else
        echo " [FAIL] Configuration could not be loaded"
        failures=$((failures + 1))
    fi
    if get_battery_state; then
        printf ' [OK] Battery %s%% — %s\n' "$BATTERY_PERCENT" "$(battery_status_label)"
    else
        echo " [FAIL] No supported internal battery detected"
        failures=$((failures + 1))
    fi
    if settings=$(get_audio_settings); then
        printf ' [OK] Audio settings readable (%s)\n' "$settings"
    else
        echo " [FAIL] Audio settings unavailable in this session"
        failures=$((failures + 1))
    fi
    if [ -f "$PLIST_DST" ] && plutil -lint "$PLIST_DST" >/dev/null 2>&1; then
        echo " [OK] LaunchAgent plist valid"
    else
        echo " [INFO] LaunchAgent is not installed"
    fi
    if is_service_running; then
        echo " [OK] Background service loaded"
    else
        echo " [INFO] Background service stopped"
    fi
    echo "──────────────────────────────────────────────────────────────────────────"
    if [ "$failures" -eq 0 ]; then
        echo "Battmon doctor found no blocking errors."
    else
        echo "Battmon doctor found $failures blocking error(s)."
        return 1
    fi
}

case "$1" in
    -h|--help|help)
        show_help
        ;;
    status)
        show_status
        ;;
    install|start)
        service_install
        ;;
    stop)
        service_stop
        ;;
    restart)
        service_restart
        ;;
    run)
        /bin/bash "$SCRIPT_DIR/battery_monitor.sh"
        ;;
    test)
        test_voice_interruption
        ;;
    reset)
        reset_defaults
        ;;
    symlinks)
        install_symlinks
        ;;
    edit)
        ensure_active_config || exit 1
        "${EDITOR:-nano}" "$CONFIG_FILE"
        load_config || exit 1
        save_config
        ;;
    doctor)
        doctor
        ;;
    migrate|migrate-config)
        ensure_active_config || exit 1
        load_config || exit 1
        save_config
        ;;
    "")
        main_menu
        ;;
    *)
        printf 'Battmon: unknown command: %s\n\n' "$1" >&2
        show_help >&2
        exit 2
        ;;
esac
