TEST_SAY_PID=""
TEST_ORIG_VOL=""
TEST_ORIG_MUTED=""
TEST_AUDIO_MODIFIED=0

cleanup_voice_test() {
    if [ -n "$TEST_SAY_PID" ] && kill -0 "$TEST_SAY_PID" 2>/dev/null; then
        kill -TERM "$TEST_SAY_PID" 2>/dev/null || true
        wait "$TEST_SAY_PID" 2>/dev/null || true
    fi
    TEST_SAY_PID=""
    if [ "$TEST_AUDIO_MODIFIED" -eq 1 ]; then
        restore_sys_audio "$TEST_ORIG_VOL" "$TEST_ORIG_MUTED" || printf 'Warning: audio state could not be restored.\n' >&2
        TEST_AUDIO_MODIFIED=0
    fi
}

prepare_voice_test() {
    local settings
    settings=$(get_audio_settings) || {
        echo "Audio settings are unavailable; test cancelled."
        return 1
    }
    read -r TEST_ORIG_VOL TEST_ORIG_MUTED <<< "$settings"
    TEST_AUDIO_MODIFIED=0
    if [ "$TEST_ORIG_MUTED" = "true" ]; then
        set_sys_muted false || return 1
        TEST_AUDIO_MODIFIED=1
    fi
    if [ "$TEST_ORIG_VOL" -lt "$ALERT_VOLUME" ]; then
        set_sys_volume "$ALERT_VOLUME" || {
            cleanup_voice_test
            return 1
        }
        TEST_AUDIO_MODIFIED=1
    fi
    trap 'cleanup_voice_test; exit 130' INT
    trap 'cleanup_voice_test; exit 143' TERM
    trap 'cleanup_voice_test; exit 129' HUP
}

finish_voice_test() {
    cleanup_voice_test
    trap - INT TERM HUP
}

speak_test_once() {
    local message="$1"
    prepare_voice_test || return 1
    echo "Speaking: \"$message\"..."
    say "$message"
    local result=$?
    finish_voice_test
    return "$result"
}

run_interrupt_test() {
    local mode="$1" message="$2" start_source active_volume check_seconds settings current_volume current_muted index
    get_battery_state || {
        echo "Battery status is unavailable; test cancelled."
        return 1
    }
    start_source="$BATTERY_SOURCE"
    prepare_voice_test || return 1
    active_volume="$TEST_ORIG_VOL"
    [ "$active_volume" -lt "$ALERT_VOLUME" ] && active_volume="$ALERT_VOLUME"
    check_seconds=$(awk -v ms="$CHECK_INTERVAL_MS" 'BEGIN { printf "%.3f", ms / 1000 }')

    index=1
    while [ "$index" -le 10 ]; do
        echo "[Repetition $index/10] Change charger state or press Mute/Volume Down."
        say "$message" &
        TEST_SAY_PID=$!
        while kill -0 "$TEST_SAY_PID" 2>/dev/null; do
            if get_battery_state; then
                if [ "$mode" = "charger" ] && [ "$BATTERY_SOURCE" != "$start_source" ]; then
                    echo ">>> SUCCESS: power-source change detected immediately."
                    finish_voice_test
                    return 0
                fi
            fi
            if settings=$(get_audio_settings); then
                read -r current_volume current_muted <<< "$settings"
                if [ "$current_muted" = "true" ] || [ "$current_volume" -lt "$active_volume" ]; then
                    echo ">>> SUCCESS: hardware audio change detected immediately."
                    TEST_AUDIO_MODIFIED=0
                    finish_voice_test
                    return 0
                fi
            fi
            sleep "$check_seconds"
        done
        wait "$TEST_SAY_PID" 2>/dev/null || true
        TEST_SAY_PID=""
        sleep 0.1
        index=$((index + 1))
    done
    finish_voice_test
    echo "Test completed without an interruption."
}

test_voice_interruption() {
    load_config || return
    echo ""
    echo "─── Test Voice & Silencing Cutoffs ───────────────────────────────────────"
    echo "  1) Speak a custom word or phrase once"
    echo "  2) Speak an existing alert phrase once"
    echo "  3) Test charger cutoff"
    echo "  4) Test keyboard Mute or Volume Down cutoff"
    echo "  5) Test pause, voice, and resume with playing media"
    echo "  6) Return to Main Menu"
    echo "──────────────────────────────────────────────────────────────────────────"
    local tchoice custom_phrase idx=1 midx start_key
    if ! prompt_number "Enter choice [1-6] (or 'c' to cancel): " 1 6 "6" tchoice; then
        return
    fi

    case "$tchoice" in
        1)
            if ! read -r -p "Phrase to say (or 'c' to cancel): " custom_phrase; then return; fi
            [ "$custom_phrase" = "c" ] || [ "$custom_phrase" = "C" ] || [ -z "$custom_phrase" ] || speak_test_once "$custom_phrase"
            ;;
        2)
            for alert in "${ALERTS[@]}"; do
                parse_alert_entry "$alert"
                printf "  [%d] \"%s\"\n" "$idx" "$PARSED_MSG"
                idx=$((idx + 1))
            done
            if ! prompt_number "Choose message number [1-${#ALERTS[@]}] (or 'c' to cancel): " 1 "${#ALERTS[@]}" "" midx; then return; fi
            parse_alert_entry "${ALERTS[$((midx - 1))]}"
            speak_test_once "$PARSED_MSG"
            ;;
        3|4)
            if ! read -r -p "Press [Enter] to begin (or 'c' to cancel): " start_key; then return; fi
            [ "$start_key" = "c" ] || [ "$start_key" = "C" ] || run_interrupt_test "$([ "$tchoice" = "3" ] && echo charger || echo audio)" "Charge up your battery now"
            ;;
        5)
            echo ""
            echo "Start media in Music, Spotify, QuickTime, Chrome, Brave, or Safari."
            echo "Battmon will pause it, speak once, restore the exact system volume,"
            echo "then resume only what it paused from the same position."
            echo "If macOS asks for permission to control the player, choose Allow."
            if ! read -r -p "Press [Enter] when the media is playing (or 'c' to cancel): " start_key; then return; fi
            if [ "$start_key" != "c" ] && [ "$start_key" != "C" ]; then
                /bin/bash "$SCRIPT_DIR/battery_monitor.sh" --test-media
                read -r -p "Press [Enter] to return to the main menu..." || true
            fi
            ;;
        6) return ;;
    esac
}

service_menu() {
    while true; do
