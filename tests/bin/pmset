#!/bin/bash
source_name="${TEST_POWER_SOURCE:-Battery}"
percent="${TEST_BATTERY_PERCENT:-50}"
mode="${TEST_BATTERY_MODE:-discharging}"
printf "Now drawing from '%s Power'\n" "$source_name"
if [ "${TEST_NO_BATTERY:-0}" = "1" ]; then
    exit 0
fi
printf " -InternalBattery-0 (id=1)\t%s%%; %s; 1:00 remaining present: true\n" "$percent" "$mode"
